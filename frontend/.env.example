# Vite only exposes variables prefixed with VITE_ to client code.
# API endpoint of the linked VijayavaniSchoolManagement backend API
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# Public URL of the R2 public bucket for avatars & school logos
VITE_STORAGE_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Web push (Announcement Module) — public half of the backend's VAPID key pair.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Base URL of the linked school project (school-level pages open there).
VITE_SCHOOL_APP_URL=http://localhost:5173
